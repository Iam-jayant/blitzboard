# ===========================================
# Wannabe Farcaster Mini App - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Public URL (required for Farcaster frame metadata)
# Use cloudflared or ngrok URL for local dev, or your deployed URL
NEXT_PUBLIC_URL=http://localhost:3000

# Supabase (same as the main wannabe app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Neynar API Key (for webhook verification)
NEYNAR_API_KEY=
