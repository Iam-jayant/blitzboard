<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f0f23"/>
      <stop offset="50%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#836EF9"/>
    </linearGradient>
    <linearGradient id="text-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#836EF9"/>
      <stop offset="50%" style="stop-color:#E8735A"/>
      <stop offset="100%" style="stop-color:#4ECDC4"/>
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#bg)"/>
  <text x="300" y="160" text-anchor="middle" font-family="system-ui" font-size="48" font-weight="bold" fill="url(#text-grad)">⚡ BlitzBoard</text>
  <text x="300" y="210" text-anchor="middle" font-family="system-ui" font-size="18" fill="#999">Quadratic Voting on Monad</text>
  <text x="300" y="260" text-anchor="middle" font-family="system-ui" font-size="14" fill="#666">Vote on hackathon submissions • On-chain • Parallel execution</text>
  <rect x="200" y="300" width="200" height="40" rx="20" fill="#836EF9" opacity="0.9"/>
  <text x="300" y="326" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="bold" fill="white">Launch App</text>
</svg>
