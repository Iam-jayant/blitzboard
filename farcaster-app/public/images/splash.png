<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 200 200">
  <defs>
    <linearGradient id="splash-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#836EF9"/>
      <stop offset="100%" style="stop-color:#4ECDC4"/>
    </linearGradient>
  </defs>
  <rect width="200" height="200" rx="40" fill="url(#splash-bg)"/>
  <text x="100" y="90" text-anchor="middle" font-family="system-ui" font-size="60">⚡</text>
  <text x="100" y="130" text-anchor="middle" font-family="system-ui" font-size="16" font-weight="bold" fill="white">BlitzBoard</text>
  <text x="100" y="152" text-anchor="middle" font-family="system-ui" font-size="10" fill="rgba(255,255,255,0.7)">Quadratic Voting</text>
</svg>
